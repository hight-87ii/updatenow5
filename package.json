{
  "name": "event-ticketing-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter api run typecheck && pnpm --filter web run typecheck",
    "setup:local": "pnpm install --frozen-lockfile && pnpm --filter api exec prisma generate && pnpm --filter api exec prisma migrate deploy",
    "verify:s01": "node scripts/verify-s01-gates.mjs",
    "verify:rollback": "node scripts/verify-s01-rollback.mjs",
    "backup:s55": "node scripts/s55-backup.mjs --keep 14",
    "restore:s55": "node scripts/s55-restore.mjs",
    "verify:s55": "node --test scripts/s55-retention.spec.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
