generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  password            String
  fullName            String?
  isEmailVerified     Boolean              @default(false)
  activationToken     String?
  activationExpires   DateTime?            @db.Timestamptz(3)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  userRoles           UserRole[]
  sessions            Session[]
  events              Event[]              @relation("OrganizerEvents")
  holdSessions        HoldSession[]
  orders              Order[]
  showtimeStaff       ShowtimeStaff[]
  checkInPermissions  CheckInPermission[]
  admissions          TicketAdmission[]
  offlineScanLogs     OfflineScanLog[]
  registrationConsent RegistrationConsent?
  activationTokens    ActivationToken[]
  reconciliationRuns   ReconciliationRun[]

  @@map("users")
}

model RegistrationConsent {
  userId        String   @id @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeVersion String
  purpose       String
  status        String
  acceptedAt    DateTime @default(now()) @db.Timestamptz(3)

  @@map("registration_consents")
}

model ActivationToken {
  tokenHash  String          @id
  userId     String          @db.Uuid
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime        @db.Timestamptz(3)
  consumedAt DateTime?       @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  mail       ActivationMail?

  @@index([userId])
  @@map("activation_tokens")
}

model ActivationMail {
  id             String          @id @default(uuid()) @db.Uuid
  tokenHash      String          @unique
  token          ActivationToken @relation(fields: [tokenHash], references: [tokenHash], onDelete: Cascade)
  encryptedToken String
  status         String          @default("QUEUED")
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now()) @db.Timestamptz(3)
  leaseUntil     DateTime?       @db.Timestamptz(3)
  sentAt         DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("activation_mail")
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  tokenHash String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Event {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  description      String
  location         String
  posterPath       String?
  mobilePosterPath String?
  bannerPath       String?
  categoryLabel    String?
  status           String     @default("DRAFT") // DRAFT, PUBLISHED
  organizerId      String     @db.Uuid
  organizer        User       @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  showtimes        Showtime[]
  orders           Order[]
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  @@index([organizerId])
  @@map("events")
}

model Showtime {
  id                String            @id @default(uuid()) @db.Uuid
  eventId           String            @db.Uuid
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  startTime         DateTime          @db.Timestamptz(3)
  seatMapId         String? // Nullable for now as per S-04
  status            ShowtimeStatus    @default(DRAFT)
  structureLocked   Boolean           @default(false)
  // S-42: null = không giới hạn (BTC đặt tay); mặc định 4 vé/tài khoản/suất.
  maxTicketsPerUser Int?              @default(4)
  seats             Seat[]
  categories        SeatCategory[]
  holdSessions      HoldSession[]
  orders            Order[]
  tickets           Ticket[]
  staffAssignments  ShowtimeStaff[]
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  checkInGates      CheckInGate[]
  admissions        TicketAdmission[]
  offlineScanLogs   OfflineScanLog[]

  @@index([eventId])
  @@map("showtimes")
}

enum ShowtimeStatus {
  DRAFT
  ON_SALE
  CLOSED
}

model SeatCategory {
  id         String   @id @default(uuid()) @db.Uuid
  showtimeId String   @db.Uuid
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  name       String
  price      Int?
  seats      Seat[]

  @@unique([showtimeId, name])
  @@unique([id, showtimeId])
  @@map("seat_categories")
}

model Seat {
  id         String       @id @default(uuid()) @db.Uuid
  showtimeId String       @db.Uuid
  showtime   Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  categoryId String       @db.Uuid
  category   SeatCategory @relation(fields: [categoryId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  row        String
  seatNumber Int
  isSold     Boolean      @default(false)
  hold       SeatHold?
  orderItems OrderItem[]
  tickets    Ticket[]

  @@unique([id, showtimeId])
  @@unique([showtimeId, row, seatNumber])
  @@index([categoryId, showtimeId])
  @@index([isSold])
  @@map("seats")
}

model HoldSession {
  id              String     @id @default(uuid()) @db.Uuid
  showtimeId      String     @db.Uuid
  showtime        Showtime   @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  userId          String     @db.Uuid
  user            User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessionHash     String
  token           String     @db.Uuid
  expectedSeatIds String[]   @default([]) @db.Uuid
  expiresAt       DateTime   @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  seats           SeatHold[]
  orders          Order[]

  @@unique([showtimeId, userId, sessionHash])
  @@unique([id, showtimeId])
  @@map("hold_sessions")
}

model SeatHold {
  seatId        String      @id @db.Uuid
  showtimeId    String      @db.Uuid
  seat          Seat        @relation(fields: [seatId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  holdSessionId String      @db.Uuid
  holdSession   HoldSession @relation(fields: [holdSessionId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  token         String      @db.Uuid
  expiresAt     DateTime    @db.Timestamptz(3)
  acquiredAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([seatId, showtimeId])
  @@index([expiresAt, seatId])
  @@index([holdSessionId, token])
  @@map("seat_holds")
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  PAID
  EXPIRED
  CANCELLED
  NEEDS_REVIEW
}

model Order {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventId          String?      @db.Uuid
  event            Event?       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  showtimeId       String       @db.Uuid
  showtime         Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  holdSessionId    String?      @db.Uuid
  holdToken        String?      @db.Uuid
  holdSession      HoldSession? @relation(fields: [holdSessionId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  status           OrderStatus  @default(PENDING_PAYMENT)
  paymentExpiresAt DateTime     @db.Timestamptz(3)
  expiresAt        DateTime?    @db.Timestamptz(3)
  totalAmount      Int
  items            OrderItem[]
  payments         Payment[]
  logs             OrderLog[]
  tickets          Ticket[]
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([holdSessionId, holdToken])
  @@index([userId])
  @@index([showtimeId])
  @@index([userId, showtimeId, status])
  @@index([status, paymentExpiresAt])
  @@index([expiresAt])
  @@map("orders")
}

model OrderItem {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @db.Uuid
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seatId       String            @db.Uuid
  seat         Seat              @relation(fields: [seatId], references: [id], onDelete: Restrict)
  categoryName String
  tierName     String?
  unitPrice    Int
  checkedInAt  DateTime?         @db.Timestamptz(3)
  admissions   TicketAdmission[]

  @@unique([orderId, seatId])
  @@index([seatId])
  @@map("order_items")
}

model CatalogRevision {
  id      Int @id
  version Int @default(0)

  @@map("catalog_revision")
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  AMOUNT_MISMATCH
  LATE
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  orderId       String        @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Int
  status        PaymentStatus @default(INITIATED)
  gateway       String
  gatewayRef    String        @unique
  transactionId String?
  attemptNo     Int           @default(1)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([orderId, attemptNo])
  @@unique([gateway, transactionId])
  @@index([orderId])
  @@index([transactionId])
  @@index([status])
  @@map("payments")
}

enum ReconciliationLineType {
  MATCHED
  SYSTEM_ONLY
  PROVIDER_ONLY
  AMOUNT_MISMATCH
}

model ReconciliationRun {
  id          String                @id @default(uuid()) @db.Uuid
  createdById String                @db.Uuid
  createdBy   User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  provider    String
  fileName    String
  periodStart DateTime              @db.Timestamptz(3)
  periodEnd   DateTime              @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  lines       ReconciliationLine[]

  @@index([createdAt])
  @@map("reconciliation_runs")
}

model ReconciliationLine {
  id             String                 @id @default(uuid()) @db.Uuid
  runId          String                 @db.Uuid
  run            ReconciliationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  type           ReconciliationLineType
  transactionId  String
  gatewayRef     String?
  paymentId      String?                @db.Uuid
  systemAmount   Int?
  providerAmount Int?
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)

  @@index([runId, type])
  @@index([transactionId])
  @@map("reconciliation_lines")
}

model OrderLog {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  attemptNo Int?
  detail    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@map("order_logs")
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
}

model Ticket {
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String?      @db.Uuid
  order              Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  showtimeId         String       @db.Uuid
  showtime           Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId             String?      @db.Uuid
  seat               Seat?        @relation(fields: [seatId], references: [id], onDelete: SetNull)
  code               String       @unique
  seatLabel          String
  ticketType         String
  status             TicketStatus @default(VALID)
  checkedInAt        DateTime?    @db.Timestamptz(3)
  cancelledAt        DateTime?    @db.Timestamptz(3)
  price              Int          @default(0)
  reminderSentAt     DateTime?    @db.Timestamptz(3)
  remindedStartTime  DateTime?    @db.Timestamptz(3)
  // S-26: QR signature made once at issue time. keyId names the signing key
  // so tickets stay verifiable after the active key is rotated.
  keyId              String?
  signature          String?
  ownerEmail         String?
  transferredToEmail String?
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @default(now()) @updatedAt @db.Timestamptz(3)
  logs               TicketLog[]

  @@unique([orderId, seatId])
  @@index([showtimeId, updatedAt])
  @@index([showtimeId, status])
  @@index([orderId])
  @@map("tickets")
}

model ShowtimeStaff {
  id         String   @id @default(uuid()) @db.Uuid
  showtimeId String   @db.Uuid
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([showtimeId, userId])
  @@index([userId])
  @@map("showtime_staff")
}

model TicketLog {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action    String
  actorId   String?  @db.Uuid
  detail    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([ticketId])
  @@map("ticket_logs")
}

model CheckInGate {
  id          String              @id @default(uuid()) @db.Uuid
  showtimeId  String              @db.Uuid
  showtime    Showtime            @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  name        String
  permissions CheckInPermission[]
  admissions  TicketAdmission[]

  @@unique([showtimeId, name])
  @@unique([id, showtimeId])
  @@map("check_in_gates")
}

model CheckInPermission {
  userId      String      @db.Uuid
  gateId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  gate        CheckInGate @relation(fields: [gateId], references: [id], onDelete: Restrict)
  staffName   String
  canOverride Boolean     @default(false)

  @@id([userId, gateId])
  @@map("check_in_permissions")
}

model TicketAdmission {
  id             String      @id @default(uuid()) @db.Uuid
  ticketId       String      @db.Uuid
  ticket         OrderItem   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  showtimeId     String      @db.Uuid
  showtime       Showtime    @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  gateId         String      @db.Uuid
  gate           CheckInGate @relation(fields: [gateId, showtimeId], references: [id, showtimeId], onDelete: Restrict)
  gateName       String
  staffId        String      @db.Uuid
  staff          User        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffName      String
  requestId      String      @db.Uuid
  kind           String
  reason         String?
  ownerConfirmed Boolean     @default(false)
  enteredAt      DateTime    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  @@unique([staffId, requestId])
  // Partial unique NORMAL ticket and CHECK constraints are maintained by migration SQL.
  @@index([ticketId, enteredAt], map: "ticket_admissions_ticket_time")
  @@map("ticket_admissions")
}

model OfflineScanLog {
  id         String   @id @default(uuid()) @db.Uuid
  scanId     String   @unique @db.Uuid
  ticketCode String
  showtimeId String   @db.Uuid
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  gateId     String?  @db.Uuid
  staffId    String   @db.Uuid
  staff      User     @relation(fields: [staffId], references: [id], onDelete: Restrict)
  deviceId   String
  scannedAt  DateTime @db.Timestamptz(3)
  status     String // 'ACCEPTED' | 'CONFLICT' | 'DUPLICATE' | 'INVALID'
  message    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([showtimeId, ticketCode])
  @@index([staffId])
  @@map("offline_scan_logs")
}
